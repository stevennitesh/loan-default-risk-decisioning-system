# OS, editor, and notebook noise
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.ipynb_checkpoints/

# Local environment, secrets, and machine-specific config
.env
.env.*
!.env.example
*.local
.python-version

# Python environments, bytecode, build outputs, and package metadata
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
build/
dist/
*.egg-info/
.eggs/

# Python test, lint, type-check, and coverage caches
.pytest_cache/
pytest-cache-files-*/
.ruff_cache/
.mypy_cache/
.pyre/
.hypothesis/
.coverage
.coverage.*
coverage.xml
junit.xml
htmlcov/

# Local scratch and agent/tooling state
.tmp/*
.agents/
.codex/

# Data: exclude every source/intermediate path; keep directory placeholders only.
/data/**
!/data/**/
!/data/**/.gitkeep

# Local databases and query scratch files
*.duckdb
*.duckdb.wal
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Model and experiment artifacts
models/*
!models/.gitkeep
*.pkl
*.pickle
*.joblib
*.onnx
*.lgb
mlruns/
wandb/

# Runtime outputs are local. Reports are excluded unless explicitly curated below.
artifacts/
outputs/
/reports/**
!/reports/**/
!/reports/**/.gitkeep

